<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened runtime, deliberately minimal. Nothing here is a blanket exception:
         - no app sandbox: the app edits the user's project files and runs their build tools;
         - no JIT, no library-validation opt-out, no DYLD variables: MLX uses Metal compute
           shaders (a resource, not CPU JIT) and every dependency is statically linked;
         - no keychain-access-groups: that is a restricted entitlement needing a provisioning
           profile, and the app only uses its own default keychain items.
         Add an entitlement only after a hardened-runtime run proves it is needed. -->
    <key>com.apple.security.app-sandbox</key>
    <false/>
</dict>
</plist>
